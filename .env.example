# ---------------------------------------------------------------------------
# NVIDIA AI web application - environment configuration
# Copy to `.env` and fill in real values. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# Application
APP_ENV=production
APP_NAME=NVIDIA AI

# Generate a strong random value, e.g.:  openssl rand -hex 32
SECRET_KEY=

# ---- NVIDIA API (server-side only; never exposed to the browser) ----
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_SECONDS=60
NVIDIA_MAX_RETRIES=2

# ---- Database ----
# For docker-compose this points at the internal `postgres` service.
DATABASE_URL=postgresql+psycopg://nvidia:CHANGE_ME@postgres:5432/nvidia_ai
POSTGRES_USER=nvidia
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=nvidia_ai

# ---- Cookies / sessions ----
# COOKIE_SECURE defaults to true in production; only override for local http.
# COOKIE_SECURE=true
SESSION_TTL_HOURS=336
COOKIE_SAMESITE=lax

# ---- CORS (browser origins allowed to call the API) ----
# When served behind the bundled reverse proxy on one origin this can stay as
# your public site origin.
CORS_ORIGINS=https://yourdomain.com

# ---- Rate limiting / limits ----
MAX_REQUESTS_PER_MINUTE=60
MAX_DAILY_REQUESTS=1000
AUTH_MAX_ATTEMPTS_PER_MINUTE=10
MAX_FILE_SIZE=10485760
MAX_MESSAGE_LENGTH=32000
MAX_CONTEXT_TOKENS=8000

# ---- Uploads ----
UPLOAD_DIR=/data/uploads

# ---- Public site origin used by the reverse proxy (Caddy) ----
# Use ":80" for local http, or your domain (e.g. yourdomain.com) for auto-HTTPS.
SITE_ADDRESS=:80
